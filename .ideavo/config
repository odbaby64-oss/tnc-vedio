{
  "systemSetup": [
    {
      "name": "Install pnpm globally",
      "command": "npm i -g pnpm"
    }
  ],
  "templateName": "custom",
  "projectDependencies": [
    {
      "name": "Install Dependencies",
      "command": "pnpm install"
    }
  ],
  "codeChecks": [
    {
      "name": "TypeCheck",
      "command": "pnpm run typecheck"
    }
  ],
  "buildSteps": [
    {
      "name": "Build Project",
      "command": "pnpm run build"
    }
  ],
  "runStep": [
    {
      "name": "Run Dev Server",
      "command": "PORT=3000 pnpm --filter @workspace/api-server run dev",
      "port": "3000"
    }
  ],
  "deploySteps": [],
  "cleanupFiles": [
    "node_modules",
    "artifacts/api-server/dist",
    "artifacts/tnc-web/dist",
    "artifacts/api-server/.tsbuildinfo",
    "artifacts/tnc-web/.tsbuildinfo"
  ],
  "packageManager": "pnpm",
  "envPaths": [
    {
      "name": "default",
      "path": ".env"
    }
  ]
}